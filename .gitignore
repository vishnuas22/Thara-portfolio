# DB recovery snapshots ship via the delivery zip, not git (21MB binaries —
# keep checkpoints small; live file + these on-disk copies + zip = triple cover)
db/custom.db.backup-*
db/custom.db.snapshot-*

# Delivery archives — NEVER commit: zip embeds .git; committing it back creates
# exponential self-nesting bloat on every re-export. Rebuild via scripts/make-project-zip.sh
upload/cogni-project.zip
.dev-daemon.pid
# Delivery archives (delivered 2026-09-02; user confirmed download) — rebuild via scripts/make-project-zip.sh
download/cogni-project-full*.zip
download/cogni-part-*
upload/*
!upload/.gitkeep

